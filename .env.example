PORT=3000
BASE_URL=http://localhost:3000
MONGO_URI=mongodb://127.0.0.1:27017/campuspulse
JWT_SECRET=put-a-long-random-string-here-40-chars-or-more

# ---- EMAIL: fill ONE of these (leave all empty = emails print in the terminal) ----
# Gmail (app password):  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=16-char-app-password
# Brevo:                 SMTP_HOST=smtp-relay.brevo.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CampusPulse <you@gmail.com>"
# Optional Outlook (Microsoft Graph OAuth2): needs an Entra app, then `npm run outlook-login`
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT=common

# Demo helper: the seeded student IDs are not real mailboxes. Put YOUR real inbox here and
# every email (6-digit codes, ticket emails) is delivered to it, with "[for student01@kct.ac.in]" in the subject.
DEMO_MAIL_TO=

# ---- SMS: console | fast2sms | twilio ----
SMS_PROVIDER=console
FAST2SMS_KEY=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Every seeded worker gets this number (run: npm run seed)
WORKER_PHONE=7904335564
